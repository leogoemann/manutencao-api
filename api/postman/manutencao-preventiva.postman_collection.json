          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json().find(x => x.maquina_id == pm.collectionVariables.get(\"maquinaId\"));",
                  "pm.test(\"máquina aparece nos alertas\", () => pm.expect(a).to.exist);",
                  "pm.test(\"mensagem legível\", () => pm.expect(a.mensagem).to.eql(\"Faltam 5 h para a manutenção\"));"
                ]
              }
            }
          ]
        },
