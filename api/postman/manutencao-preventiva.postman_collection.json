          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"formato de erro\", () => pm.expect(pm.response.json()).to.have.key(\"error\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar máquina",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/maquinas/{{maquinaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maquinas",
                "{{maquinaId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maquina\": {\n    \"localizacao\": \"Linha 4\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"atualizou\", () => pm.expect(pm.response.json().localizacao).to.eql(\"Linha 4\"));"
                ]
              }
            }
          ]
        }
      ]
    },
