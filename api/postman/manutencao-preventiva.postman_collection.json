            "url": {
              "raw": "{{baseUrl}}/maquinas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maquinas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"é lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhar máquina",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/maquinas/{{maquinaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maquinas",
                "{{maquinaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhar máquina inexistente",
          "request": {
            "method": "GET",
            "header": [
