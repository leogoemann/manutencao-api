{
  "info": {
    "name": "Manutenção Preventiva API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Smoke tests da API de manutenção preventiva. Execute em ordem (Postman Runner ou Newman)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "maquinaId",
      "value": ""
    },
    {
      "key": "codigo",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"codigo\")) pm.collectionVariables.set(\"codigo\", \"PM-\" + Date.now());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Máquinas",
      "item": [
        {
          "name": "Cadastrar máquina",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/maquinas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maquinas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maquina\": {\n    \"nome\": \"Fresadora Postman\",\n    \"codigo\": \"{{codigo}}\",\n    \"fabricante\": \"Romi\",\n    \"intervalo_manutencao_horas\": 100\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"maquinaId\", j.id);",
                  "pm.test(\"começa em dia\", () => pm.expect(j.status_manutencao).to.eql(\"em_dia\"));",
                  "pm.test(\"horas zeradas\", () => pm.expect(j.horas_uso_total).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar máquina inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/maquinas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maquinas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maquina\": {\n    \"nome\": \"\",\n    \"codigo\": \"\",\n    \"intervalo_manutencao_horas\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"erros por campo\", () => pm.expect(pm.response.json().errors).to.include.keys(\"nome\",\"codigo\",\"intervalo_manutencao_horas\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar máquinas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
